# Local machine configuration — contains sensitive paths and hostnames
# Copy config.sh.example to config.sh and fill in your values.
# The glob also covers hand-carried copies like config.sh.20260824 or
# config.sh.ptah. The negation must stay last, or the template gets caught too.
config.sh*
.config.sh*
!config.sh.example

# Temporary files
*.bak
*_tmp.sh
calibre_nightly_backup_tmp.sh

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Logs (stored in ~/Code/FourM/Logs, not in repo)
*.log

# Full-text search output (REVIEW_DIR). The default is $HOME/Code/FourM/Reviews,
# outside the repo, so none of this should ever match. It stays as a backstop
# for anyone who points REVIEW_DIR inside the repo anyway: .snippets.txt holds
# passages copied out of your books, and this repo is public.
#
# The backstop is partial by nature. REVIEW_DIR is yours to name, so the
# directory rule below only catches the obvious choice; the extension globs do
# the real work, and only while the script keeps writing these three suffixes.
# Keeping REVIEW_DIR out of the repo is the actual fix.
reviews/
*.ids
*.snippets.txt
*.vl.txt

# Local workplan / research documents — never committed. See knowledge-capture-conventions.
/_research

#!/usr/bin/env bash
# config.sh.example
# Copy this file to config.sh and fill in your actual values.
# config.sh is gitignored and will never be committed to the repository.
#
# All scripts source this file automatically via:
#   source "$(dirname "$0")/config.sh"
#
# Every path a script needs lives here, including the ones under $HOME.
# Keeping them in one place means no script hardcodes a location, so
# there is a single source of truth and a single place to change it.
# Variables using $HOME are resolved at runtime, so you do not need to
# hardcode your username.

# ── Paths ─────────────────────────────────────────────────────────────────────
# Calibre library
LIBRARY="$HOME/Calibre Library"

# Where all logs are written (shared by every script)
LOG_DIR="$HOME/Code/FourM/Logs"

# Python venv holding the CalibreWeb (cps) install
VENV_DIR="$HOME/Code/venv/calibre-web-env"

# CalibreWeb's own config directory (holds app.db and calibre-web.log)
CALIBRE_WEB_CONFIG="$HOME/.calibre-web"

# calibredb binary from the Calibre desktop app
CALIBREDB="/Applications/calibre.app/Contents/MacOS/calibredb"

# Where calibre_fts_search.sh writes its results (.ids, .snippets.txt, .vl.txt).
# These are working files you come back to, not logs, so they are not rotated.
# If this is missing from an older config.sh the script falls back to
# $LOG_DIR/reviews rather than failing.
#
# Keep this OUTSIDE the repo, next to $LOG_DIR. .snippets.txt holds passages
# copied out of your books and this is a public repo. Since you choose the
# path, no committed .gitignore can know what to exclude — pointing it inside
# the repo means editing .gitignore by hand and remembering to, every time.
REVIEW_DIR="$HOME/Code/FourM/Reviews"

# Where these scripts live. Leave commented out and each script uses its
# own directory, which is correct in almost all cases. Uncomment only if
# you need a script to call its siblings at a different location.
# SCRIPT_DIR="$HOME/Code/FourM/Calibre"

# ── Backup destinations ───────────────────────────────────────────────────────
# External drive backup root — drive name is machine specific
HOST_BACKUP="/Volumes/YOUR_EXTERNAL_DRIVE/CalibreBackups"

# iCloud backup root
ICLOUD_BACKUP="$HOME/Documents/Backups/Calibre"

# The nightly backup warns (in its _FAILED log) when the external drive has
# less free space than this, in GB. Optional; 50 if unset.
MIN_FREE_GB=50

# ── Backup hub (optional) ─────────────────────────────────────────────────────
# calibre_backup_to_hub.sh copies every snapshot in HOST_BACKUP to another Mac
# over ssh, keeping the hard links (rsync -aH), for example so that Mac can
# take them off-site. The nightly backup runs it as its last step when
# HUB_SSH_HOST is set; leave it empty and that step is skipped.
#
# HUB_SSH_HOST is a Host from ~/.ssh/config. Its key must work without a
# passphrase or an agent, since the nightly runs under launchd.
HUB_SSH_HOST=""                                    # e.g. backup-hub
HUB_BACKUP="/Volumes/YOUR_HUB_DRIVE/CalibreBackups"
# Refuse to run if more than this many snapshots would be deleted on the hub
# (a normal night deletes one or two). Override once with --allow-deletes.
MAX_HUB_SNAPSHOT_DELETES=3
# calibre_backup_now.sh (by hand) mirrors the live library here on the hub,
# without full-text-search.db; the nightly's last step brings it up to that
# night's snapshot (calibre_refresh_library_copy.sh). Empty: that step is skipped. Keep it outside HUB_BACKUP: that copy deletes
# anything in HUB_BACKUP that is not on the drive.
HUB_LIBRARY_COPY="/Volumes/YOUR_HUB_DRIVE/CalibreLibrary"


# ── CalibreWeb ────────────────────────────────────────────────────────────────
# Public URL where CalibreWeb is accessible
CALIBRE_HOST="https://your-calibre-domain:YOUR_PORT"

# Port CalibreWeb listens on
PORT=YOUR_PORT

# SSL certificate and key — filenames may vary
CERT_FILE="$HOME/Code/FourM/Software/Calibre-Keys/your_cert.pem"
KEY_FILE="$HOME/Code/FourM/Software/Calibre-Keys/your_key.key"

# tmux session name CalibreWeb runs in
TMUX_SESSION="calibreweb"

# ── CalibreWeb as a service (optional) ────────────────────────────────────────
# Leave CALIBRE_WEB_SERVICE_LABEL empty and CalibreWeb runs as you, in tmux.
# Set it and CalibreWeb runs as its own hidden macOS user under launchd, with
# no access to your home folder; setup_calibreweb_service.sh builds it, and
# start/stop_calibreweb.sh switch to loading and unloading the LaunchDaemon.
#
# In service mode some keys above must point into the service folder, and the
# library must be outside your home folder (the service user cannot enter it):
#
#   LIBRARY="/Users/Shared/Calibre Library"
#   VENV_DIR="$CALIBRE_WEB_SERVICE_DIR/venv"
#   CALIBRE_WEB_CONFIG="$CALIBRE_WEB_SERVICE_DIR/config"
#   CERT_FILE="$CALIBRE_WEB_SERVICE_DIR/tls/your_cert.pem"
#   KEY_FILE="$CALIBRE_WEB_SERVICE_DIR/tls/your_key.key"
#
# (Set CALIBRE_WEB_SERVICE_DIR before those lines, since they use it.)
CALIBRE_WEB_SERVICE_LABEL=""                       # e.g. info.fourm.calibre-web
CALIBRE_WEB_SERVICE_USER="_calibreweb"            # role account: _ and an id in 450-499
CALIBRE_WEB_SERVICE_DIR="/usr/local/calibre-web"

# ── Rotation policy ───────────────────────────────────────────────────────────
KEEP_DAILY=7
KEEP_WEEKLY=4
KEEP_MONTHLY=2
KEEP_YEARLY=1

# How many log files each script keeps before pruning the oldest
KEEP_LOGS=30
